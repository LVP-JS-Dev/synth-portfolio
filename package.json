{
  "name": "synth-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node -e \"require('fs').rmSync('out/admin',{recursive:true,force:true})\"",
    "start": "node ./scripts/serve-out.mjs",
    "cms:server": "decap-server",
    "lint": "eslint",
    "pretypecheck": "node -e \"require('fs').rmSync('.next/types',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "build:static:en": "node ./scripts/build-static.mjs --locale=en --out=out-en",
    "build:static:ru": "node ./scripts/build-static.mjs --locale=ru --out=out-ru",
    "deploy:vercel": "bash ./scripts/deploy/vercel.sh",
    "deploy:yc:ru": "bash ./scripts/deploy/yandex-storage-ru.sh"
  },
  "dependencies": {
    "@markdoc/markdoc": "^0.5.6",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "decap-server": "^3.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "jsdom": "^22",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
